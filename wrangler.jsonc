{
  // Corrida para a Presidência · 2º turno: Worker + arquivos estáticos (Cloudflare Workers)
  "name": "corridaparapresidencia",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Arquivos de public/ são servidos direto (sem gastar cota); o Worker só roda para /api/*
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Agendador: a cada minuto o Worker grava um ponto do histórico (só durante a apuração)
  "triggers": { "crons": ["* * * * *"] },
  // Armazenamento do histórico minuto a minuto (Durable Object com SQLite, disponível no plano grátis)
  "durable_objects": { "bindings": [{ "name": "HIST", "class_name": "Historico" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Historico"] }],
  // Logs do Worker no painel da Cloudflare (Workers > corridaparapresidencia > Logs): mostram, a cada minuto,
  // o que o agendador gravou e qualquer erro (útil na noite da apuração)
  "observability": { "enabled": true }
}
